# Salin ke .env lalu sesuaikan. Dipakai oleh docker-compose.yml.

# --- WAJIB diganti di production ---
POSTGRES_PASSWORD=ganti-password-postgres
MINIO_ROOT_USER=cbt-minio
MINIO_ROOT_PASSWORD=ganti-password-minio-min-8
# Minimal 32 karakter acak, mis: openssl rand -base64 48
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter-xxxxxxxxxxxx
# Admin awal (dibuat sekali oleh `seed` bila belum ada user)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ganti-password-admin

# --- opsional ---
# Port publik panel admin + API
HTTP_PORT=8080
# Origin panel admin (CORS). Bila admin & API di host yang sama lewat nginx, biarkan.
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info
WORKER_CONCURRENCY=4
JWT_ADMIN_TTL=12h
JWT_SITE_TTL=24h
